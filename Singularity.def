Bootstrap: library
From: ubuntu:22.04

%labels
    org.opencontainers.image.title PhyloPrep
    org.opencontainers.image.description "Auditable phylogenomic matrix preparation"
    org.opencontainers.image.source "https://github.com/thecgs/MSAP"
    org.opencontainers.image.licenses "MIT"

%files
    AA2Codon.py /opt/phyloprep/AA2Codon.py
    MSAP.py /opt/phyloprep/MSAP.py
    MSAP_batch.py /opt/phyloprep/MSAP_batch.py
    alignment_qc.py /opt/phyloprep/alignment_qc.py
    calulate_4dtv_and_correction.py /opt/phyloprep/calulate_4dtv_and_correction.py
    extract_4-fold_degenerated_sites.py /opt/phyloprep/extract_4-fold_degenerated_sites.py
    extract_orthofinder_orthogroups.py /opt/phyloprep/extract_orthofinder_orthogroups.py
    fasta2axt.py /opt/phyloprep/fasta2axt.py
    fasta2nex.py /opt/phyloprep/fasta2nex.py
    fasta2phy.py /opt/phyloprep/fasta2phy.py
    filter_sequences.py /opt/phyloprep/filter_sequences.py
    get_supergenes.py /opt/phyloprep/get_supergenes.py
    msap_io.py /opt/phyloprep/msap_io.py
    oma_to_orthogroups.py /opt/phyloprep/oma_to_orthogroups.py
    orthogroup_table.py /opt/phyloprep/orthogroup_table.py
    orthomcl_to_orthogroups.py /opt/phyloprep/orthomcl_to_orthogroups.py
    phyloprep.py /opt/phyloprep/phyloprep.py
    proteinortho_to_orthogroups.py /opt/phyloprep/proteinortho_to_orthogroups.py
    rename_taxa.py /opt/phyloprep/rename_taxa.py
    sequence_audit.py /opt/phyloprep/sequence_audit.py
    sonicparanoid_to_orthogroups.py /opt/phyloprep/sonicparanoid_to_orthogroups.py
    split_codon_seqence_alignment.py /opt/phyloprep/split_codon_seqence_alignment.py
    trimAlnSeq.py /opt/phyloprep/trimAlnSeq.py
    README.md /opt/phyloprep/README.md
    LICENSE.txt /opt/phyloprep/LICENSE.txt

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        bzip2 ca-certificates curl default-jre-headless
    rm -rf /var/lib/apt/lists/*

    # Install a pinned micromamba binary, then use Bioconda for the alignment
    # tools.  This keeps their native dependencies out of the base image.
    curl --fail --location --retry 3 \
        --output /tmp/micromamba.tar.bz2 \
        https://micro.mamba.pm/api/micromamba/linux-64/2.0.5
    tar -xjf /tmp/micromamba.tar.bz2 -C /tmp bin/micromamba
    install -m 0755 /tmp/bin/micromamba /usr/local/bin/micromamba
    rm -rf /tmp/micromamba.tar.bz2 /tmp/bin

    micromamba create -y -p /opt/conda \
        -c conda-forge -c bioconda --strict-channel-priority \
        python=3.11 biopython mafft muscle=5 prank clustalw trimal fasttree iqtree blast
    micromamba clean --all --yes

    # MACSE v2.07 is obtained from its official distribution site rather than
    # copied from a workstation-local JAR.
    curl --fail --location --retry 3 \
        --output /opt/phyloprep/macse_v2.07.jar \
        https://www.agap-ge2pop.org/wp-content/uploads/macse/releases/macse_v2.07.jar
    echo "96873a1465f1e1aa9d0c462d469eee6954d36e8639727f69f34a72fcb6583963  /opt/phyloprep/macse_v2.07.jar" | sha256sum -c -

    # The OrthoFinder release bundles DIAMOND, MCL and FastME.  FastTree and
    # IQ-TREE are installed above because they are optional tree methods in
    # OrthoFinder's default configuration but are not bundled in this archive.
    curl --fail --location --retry 3 \
        --output /tmp/orthofinder-2.5.5.tar.gz \
        https://github.com/davidemms/OrthoFinder/releases/download/2.5.5/OrthoFinder.tar.gz
    mkdir -p /tmp/orthofinder-unpack
    tar -xzf /tmp/orthofinder-2.5.5.tar.gz -C /tmp/orthofinder-unpack
    install -d /opt/orthofinder
    orthofinder_dir=$(dirname "$(find /tmp/orthofinder-unpack -type f -name orthofinder -print -quit)")
    test -x "$orthofinder_dir/orthofinder"
    cp -a "$orthofinder_dir/." /opt/orthofinder/
    rm -rf /tmp/orthofinder-2.5.5.tar.gz /tmp/orthofinder-unpack
    chmod 755 /opt/orthofinder/orthofinder /opt/orthofinder/bin/*
    if test ! -x /opt/conda/bin/iqtree && test -x /opt/conda/bin/iqtree2; then
        ln -s iqtree2 /opt/conda/bin/iqtree
    fi

    chmod 755 /opt/phyloprep/*.py

%environment
    export PHYLOPREP_HOME=/opt/phyloprep
    export PATH=/opt/orthofinder:/opt/orthofinder/bin:/opt/conda/bin:/opt/phyloprep:${PATH}

%runscript
    # Singularity binds the caller's working directory by default. Relative
    # input and output paths are therefore interpreted from that directory.
    exec /opt/conda/bin/python /opt/phyloprep/phyloprep.py "$@"

%test
    set -eu
    /opt/conda/bin/python /opt/phyloprep/phyloprep.py --help >/dev/null
    command -v mafft >/dev/null
    command -v muscle >/dev/null
    command -v prank >/dev/null
    command -v clustalw >/dev/null
    command -v trimal >/dev/null
    command -v java >/dev/null
    command -v orthofinder >/dev/null
    command -v FastTree >/dev/null
    command -v iqtree >/dev/null
    command -v makeblastdb >/dev/null
    command -v blastn >/dev/null
    orthofinder -h >/dev/null
